{
  "server": {
    "address": "localhost",
    "port": 8000,
    "reload": true,
    "debug": true
  },
  "apirest": {
    "title": "{{title_name}}",
    "description": "",
    "version": "v1",
    "credentials": true,
    "origins": ["*"],
